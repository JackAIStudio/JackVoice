{
  "name": "jackvoice",
  "private": true,
  "version": "0.1.0",
  "description": "开源桌面全局语音听写工具",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackAIStudio/JackVoice.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-desktop-dev.mjs",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "build:desktop": "node scripts/run-desktop-dev.mjs --build --production",
    "build:desktop:dev": "node scripts/run-desktop-dev.mjs --build",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~7.0.2",
    "vite": "^6.0.3"
  }
}
