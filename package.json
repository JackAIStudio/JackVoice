{
  "name": "jackvoice",
  "private": true,
  "version": "0.1.1",
  "description": "开源桌面全局语音听写工具",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackAIStudio/JackVoice.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-dev-ports.mjs",
    "dev": "node scripts/run-desktop-dev.mjs",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "build:desktop": "node scripts/run-desktop-dev.mjs --build --production",
    "build:desktop:dev": "node scripts/run-desktop-dev.mjs --build",
    "reset:first-run:dev": "node scripts/reset-first-run.mjs dev",
    "reset:first-run:production": "node scripts/reset-first-run.mjs production",
    "qa:first-run:dev": "node scripts/reset-first-run.mjs dev --quit --build --open",
    "qa:first-run:dev:fresh": "node scripts/reset-first-run.mjs dev --quit --build --forget-credential --open",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --test scripts/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
