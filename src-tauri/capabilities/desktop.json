{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "default",
      "description": "Capability for the settings and history window",
      "windows": ["main"],
      "permissions": [
        "core:default",
        "clipboard-manager:allow-write-text"
      ]
    },
    {
      "identifier": "overlay",
      "description": "Minimal capability for the dictation overlay",
      "windows": ["overlay"],
      "permissions": ["core:default"]
    }
  ]
}
